{
  "name": "cesvu",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "svelte-kit sync && vite dev",
    "build": "svelte-kit sync && vite build && pnpm freeze && pnpm sri:inject",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node ./node_modules/vitest/vitest.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "freeze": "node scripts/freeze.mjs freeze",
    "verify": "node scripts/freeze.mjs verify",
    "sri:inject": "node scripts/freeze.mjs inject",
    "sri:verify": "node scripts/freeze.mjs sri:verify",
    "models:build": "node scripts/freeze.mjs models:build",
    "licenses:build": "node scripts/generate-licenses.mjs",
    "sync:cdn": "node scripts/sync-cdn.mjs",
    "sync:cdn:upload": "node scripts/sync-cdn.mjs --upload",
    "sync:cdn:dry": "node scripts/sync-cdn.mjs --dry-run"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.21.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.1.7",
    "@types/papaparse": "^5.5.2",
    "@vite-pwa/sveltekit": "^1.1.0",
    "autoprefixer": "^10.4.21",
    "buffer": "^6.0.3",
    "eslint": "^9.20.0",
    "eslint-plugin-svelte": "^2.46.1",
    "globals": "^15.14.0",
    "license-checker-rseidelsohn": "^5.0.1",
    "svelte": "^5.28.2",
    "svelte-check": "^4.1.6",
    "svelte-eslint-parser": "^0.43.0",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9",
    "wrangler": "^4.103.0"
  },
  "dependencies": {
