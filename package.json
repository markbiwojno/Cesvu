    "mode-watcher": "^0.5.1",
    "papaparse": "^5.5.2",
    "pdfjs-dist": "^6.0.227",
    "simple-statistics": "^7.9.0",
    "svelte-sonner": "^0.3.28",
    "tailwind-merge": "^3.3.0",
    "tailwind-variants": "^0.3.1",
    "unpdf": "^1.6.2",
    "vega": "^6.2.0",
    "vega-embed": "^7.1.0",
    "vega-lite": "^6.4.3",
    "xlsx": "^0.18.5",
    "zod": "4.4.3"
  }
