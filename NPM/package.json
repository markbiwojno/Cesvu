{
  "name": "@cesvu/crypto",
  "version": "0.1.0",
  "description": "Zero-knowledge .cesvu v1 file encryption/decryption (XChaCha20-Poly1305 secretstream + Argon2id) for Node.js, sharing a byte-identical wire format with the cesvu Python CLI and web app.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_LICENSES.md",
    "TRADEMARKS.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "libsodium-wrappers-sumo": "0.7.13",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/libsodium-wrappers-sumo": "^0.7.8",
    "@types/node": "^26.2.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^4.1.9"
  },
  "keywords": [
    "cesvu",
    "encryption",
    "xchacha20poly1305",
    "argon2id",
    "libsodium",
    "secretstream"
  ]
}
